.{
    .name = .zinkhole,
    .version = "0.3.0",
    .fingerprint = 0xd30991fca906d3c6, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    // No dependencies on purpose: everything (YAML subset, DNS wire format,
    // HTTP/TLS via std) is implemented in this repository or the standard library.
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "LICENSE",
        "src",
        "README.md",
        "config.example.yaml",
        "deploy",
    },
}
