# Hardened systemd unit for zinkhole (tested on Debian 13 with systemd 257).
#
# Install with `./deploy/install.sh`, or by hand:
#   install -m 755 target/release/zinkhole /usr/local/bin/zinkhole
#   install -m 644 -D config.example.toml /etc/zinkhole/config.toml
#   install -m 644 deploy/zinkhole.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now zinkhole
#
# The service runs as a throwaway unprivileged user and may only bind port 53
# (CAP_NET_BIND_SERVICE); the file system is read-only to it, except for
# /var/lib/zinkhole, where a sync replica keeps its last settings. The config
# file must be readable by others (mode 644), as must any local list files.
# `systemctl reload zinkhole` reloads the config, `systemctl kill -s USR1
# zinkhole` logs a summary; logs: journalctl -u zinkhole

[Unit]
Description=zinkhole DNS blocker and local DNS server
After=network-online.target
Wants=network-online.target
Before=nss-lookup.target
Wants=nss-lookup.target

[Service]
ExecStart=/usr/local/bin/zinkhole serve --config /etc/zinkhole/config.toml
# The shell's own kill: /bin/kill (procps) is not on every minimal system.
# systemd passes MAINPID in the environment; $$ keeps it from expanding it.
ExecReload=/bin/sh -c 'kill -HUP $$MAINPID'
Restart=on-failure
RestartSec=2
# systemd counts death by SIGHUP as a clean exit; a SIGHUP in the moment
# before zinkhole handles it is still a failure.
RestartForceExitStatus=SIGHUP
# A socket per upstream exchange (up to upstream.max_in_flight, at most 1024),
# plus the listeners and up to 16 DNS and 16 HTTP connections.
LimitNOFILE=8192

DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

ProtectSystem=strict
# Writable /var/lib/zinkhole: a sync replica keeps its last settings there.
StateDirectory=zinkhole
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# AF_UNIX: the runtime's signal handling uses a socket pair.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
